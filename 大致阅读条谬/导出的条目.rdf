            <dcterms:URI>
                <rdf:value>https://pubs.acs.org/doi/10.1021/acs.nanolett.4c03029</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-01-10 14:31:22</dcterms:dateSubmitted>
        <dc:rights>https://creativecommons.org/licenses/by/4.0/</dc:rights>
        <dc:description>titleTranslation: Janus结构二硫族化铬中的无外场自旋轨道矩翻转</dc:description>
        <bib:pages>11889-11894</bib:pages>
