            <dcterms:URI>
                <rdf:value>https://www.nature.com/articles/s41427-018-0023-8</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-01-10 14:31:07</dcterms:dateSubmitted>
        <dc:description>titleTranslation: 基于石墨烯的二维Janus材料</dc:description>
